      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "topk(8, histogram_quantile(0.99, sum by (le, process, route) (rate(yantra_http_request_duration_seconds_bucket[5m]))))",
