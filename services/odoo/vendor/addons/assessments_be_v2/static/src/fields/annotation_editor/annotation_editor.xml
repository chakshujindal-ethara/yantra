<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!--
        The annotation editor. Every branch below is a state an operator actually
        reaches, not defensive padding: an unsaved question, a question whose
        detection has not run, an offloaded picture whose S3 URL 403s, and a
        marker the DOM-capture lane stored in pixels. Each one says what to do
        next, because the alternative on this screen is a blank grey box and a
        support ticket.
    -->
    <t t-name="assessments_be_v2.EtpAnnotationEditor">
        <div class="o_etp_annot">

            <!-- A brand-new question has no id, so the picture it would be drawn
                 on does not exist on the server yet. -->
            <div t-if="state.status === 'unsaved'" class="alert alert-info mb-0" role="status">
                <i class="fa fa-floppy-o me-2" role="img" aria-hidden="true"/>
                Save the question first - the picture and its markers are stored
                against it, so there is nothing to draw on until it exists.
            </div>

            <div t-elif="state.status === 'loading'"
                 class="o_etp_annot_loading text-muted" role="status" aria-live="polite">
                <i class="fa fa-circle-o-notch fa-spin me-2" role="img" aria-hidden="true"/>
                Loading the markers...
            </div>

            <div t-elif="state.status === 'error'" class="alert alert-danger mb-0" role="alert">
                <div class="mb-2">
                    <strong>The markers could not be loaded.</strong>
                    <span class="d-block small" t-esc="state.error"/>
                </div>
                <button type="button" class="btn btn-sm btn-outline-danger"
                        t-on-click="() => this.load()">
                    <i class="fa fa-refresh me-1" role="img" aria-hidden="true"/>Try again
                </button>
            </div>

            <div t-elif="state.status === 'blocked'" class="alert alert-warning mb-0"
                 role="status">
                <i class="fa fa-info-circle me-2" role="img" aria-hidden="true"/>
                <t t-esc="blockedMessage"/>
            </div>

            <t t-else="">
                <div class="o_etp_annot_bar">
                    <span class="o_etp_annot_count">
                        <t t-esc="keyedCount"/> / <t t-esc="state.markers.length"/> keyed
                        <t t-if="state.markerCap">
                            <span class="text-muted"> (max <t t-esc="state.markerCap"/>)</span>
                        </t>
                    </span>
                    <span class="o_etp_annot_hint text-muted">
                        Drag on the picture to draw a box - drag its middle to move
                        it, its corner to resize it.
                    </span>
                    <div class="o_etp_annot_actions">
                        <button type="button" class="btn btn-sm btn-secondary"
                                t-att-disabled="state.busy or !state.dirty"
                                t-on-click="onRevert">
                            <i class="fa fa-undo me-1" role="img" aria-hidden="true"/>Revert
                        </button>
                        <button type="button" class="btn btn-sm btn-primary"
                                t-att-disabled="state.busy or !state.dirty"
                                t-on-click="onSave">
                            <i t-attf-class="fa me-1 {{ state.busy ? 'fa-circle-o-notch fa-spin' : 'fa-check' }}"
                               role="img" aria-hidden="true"/>Save boxes &amp; labels
                        </button>
                    </div>
                </div>

                <!-- Refusals, whether this widget made them or the server did.
                     role=alert so a screen reader is told the save did not
                     happen, rather than the operator walking away believing it
                     did. -->
                <div t-if="state.problems.length" class="alert alert-danger o_etp_annot_problems"
                     role="alert">
                    <div t-foreach="state.problems" t-as="problem" t-key="problem_index"
                         t-esc="problem"/>
                </div>

                <!-- The markers a save WILL drop. See
                     `studio_annotation_editor_payload`: a stored marker with
                     neither coordinates nor a golden answer cannot be carried in
                     the item shape, and removing a mark from a paper without
                     saying so is exactly the damage the model refuses partial
                     writes to avoid. -->
                <div t-if="state.unkeyed" class="alert alert-warning o_etp_annot_problems"
                     role="alert">
                    <strong><t t-esc="state.unkeyed"/> marker(s)</strong> on this
                    picture cannot be opened here - their coordinates are stored as
                    pixels rather than as fractions of the image, so there is nothing
                    to draw or label. The server will REFUSE a save that would drop
                    them, so this question cannot be shortened by accident; it also
                    means saving is blocked until every marker is editable. Re-run
                    Detect Now to give them drawable coordinates, or correct the
                    stored Answer Key (raw JSON) directly.
                </div>

                <div t-if="state.reason === 'no_markers'" class="alert alert-info o_etp_annot_problems"
                     role="status">
                    <i class="fa fa-object-group me-2" role="img" aria-hidden="true"/>
                    No boxes on this picture yet. Drag across a defect to draw the
                    first one, or run <strong>Detect Now</strong> above to have them
                    proposed for you.
                </div>

                <div t-if="state.imageBroken" class="alert alert-warning o_etp_annot_problems"
                     role="alert">
                    The picture could not be displayed (it may have been offloaded
                    to private storage). The labels below are still editable, but do
                    not move a box you cannot see.
                </div>

                <!--
                    The plate. `o_etp_annot_plate` is exactly the rendered
                    picture: the img sets the height, the layer is inset:0 over
                    it, and every box is positioned in PER CENT. That is what
                    keeps a box on its defect at any form width without a single
                    resize listener - and why the img must never carry
                    object-fit or a max-height, either of which would letterbox
                    the bitmap inside its own box and slide every marker off it.
                -->
                <div class="o_etp_annot_plate" t-ref="plate"
                     t-att-class="{ 'o_etp_annot_plate--broken': state.imageBroken }">
                    <img class="o_etp_annot_img" t-att-src="state.mediaUrl"
                         alt="Question image being marked up"
                         draggable="false"
                         t-on-error="() => this.state.imageBroken = true"/>
                    <div class="o_etp_annot_layer" t-on-pointerdown="onLayerPointerDown">
                        <div t-foreach="drawableMarkers" t-as="marker" t-key="marker.n"
                             class="o_etp_annot_box"
                             t-att-class="{
                                 'o_etp_annot_box--selected': state.selected === marker.n,
                                 'o_etp_annot_box--unkeyed': isUnkeyed(marker),
                             }"
                             t-attf-style="left:{{ pct(marker.x) }};top:{{ pct(marker.y) }};width:{{ pct(marker.w) }};height:{{ pct(marker.h) }}"
                             tabindex="0" role="button"
                             t-att-aria-label="boxAria(marker)"
                             t-on-pointerdown.stop="(ev) => this.onBoxPointerDown(ev, marker.n)"
                             t-on-keydown="(ev) => this.onBoxKeyDown(ev, marker.n)">
                            <span class="o_etp_annot_badge" t-esc="marker.n"/>
                            <!-- A corner grip rather than eight: the box is
                                 anchored top-left on resize, so one handle can
                                 reach every shape without the flip-inside-out
                                 case eight handles have to guard. -->
                            <span class="o_etp_annot_grip" aria-hidden="true"
                                  t-on-pointerdown.stop="(ev) => this.onHandlePointerDown(ev, marker.n)"/>
                        </div>
                    </div>
                </div>

                <div class="o_etp_annot_list">
                    <div t-foreach="state.markers" t-as="marker"
                         t-key="state.generation + '-' + marker.n"
                         class="o_etp_annot_row"
                         t-att-class="{ 'o_etp_annot_row--selected': state.selected === marker.n }">
                        <span class="o_etp_annot_pill" t-esc="marker.n"/>
                        <input type="text"
                               class="form-control form-control-sm o_etp_annot_label"
                               t-att-value="marker.label"
                               t-att-aria-label="markerAria(marker)"
                               placeholder="What a correct description of this point says"
                               t-on-input="(ev) => this.onLabelInput(marker.n, ev.target.value)"
                               t-on-focus="() => this.select(marker.n)"/>
                        <!-- Pixel-only geometry, from the DOM-capture lane. The
                             label is editable; the box is not, because box_px is
                             not on the same grid as everything drawn above. -->
                        <span t-if="!marker.drawable"
                              class="badge text-bg-light border o_etp_annot_flag"
                              title="Stored in pixels by the page-capture lane, so it cannot be redrawn here. Its label is still editable.">
                            no coordinates
                        </span>
                        <button type="button"
                                class="btn btn-sm btn-link text-danger o_etp_annot_del"
                                t-att-disabled="state.busy"
                                t-att-aria-label="'Delete marker ' + marker.n"
                                t-att-title="'Delete marker ' + marker.n"
                                t-on-click="() => this.onDelete(marker.n)">
                            <i class="fa fa-trash-o" role="img" aria-hidden="true"/>
                        </button>
                    </div>

                    <div t-if="!state.markers.length" class="text-muted small py-2">
                        No markers yet.
                    </div>
                </div>
            </t>
        </div>
    </t>

</templates>
