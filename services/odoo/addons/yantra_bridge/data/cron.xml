<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_pull_paid_windows" model="ir.cron">
            <field name="name">Yantra: pull paid windows</field>
            <field name="model_id" ref="model_yantra_pay_window"/>
            <field name="state">code</field>
            <field name="code">model._cron_pull_paid_windows()</field>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <record id="action_pull_paid_windows" model="ir.actions.server">
            <field name="name">Pull paid windows now</field>
            <field name="model_id" ref="model_yantra_pay_window"/>
            <field name="binding_model_id" ref="model_yantra_pay_window"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">model.action_pull_paid_windows()</field>
        </record>
    </data>
</odoo>
