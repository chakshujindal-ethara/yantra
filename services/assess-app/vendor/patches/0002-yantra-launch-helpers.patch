# FE-1. Reading a Yantra launch link (ticket in the fragment), remembering and vetting the way back, the page to open after.
diff --git a/ethara-assessment-fe/lib/services/yantra_return_stub.dart b/ethara-assessment-fe/lib/services/yantra_return_stub.dart
new file mode 100644
index 0000000..663802a
--- /dev/null
+++ b/ethara-assessment-fe/lib/services/yantra_return_stub.dart
@@ -0,0 +1,12 @@
+/// Where "Back to Yantra" goes, held across page loads.
+///
+/// Non-web builds (and the VM the tests run on) have no browser storage, so
+/// this keeps the value in memory: enough for one run, which is all a test
+/// needs. The web build keeps it in localStorage beside the session tokens.
+library;
+
+String? _value;
+
+String? readYantraReturn() => _value;
+
+void writeYantraReturn(String? url) => _value = url;
diff --git a/ethara-assessment-fe/lib/services/yantra_return_web.dart b/ethara-assessment-fe/lib/services/yantra_return_web.dart
new file mode 100644
index 0000000..6f9d083
--- /dev/null
+++ b/ethara-assessment-fe/lib/services/yantra_return_web.dart
@@ -0,0 +1,28 @@
+import 'package:web/web.dart' as web;
+
+/// Beside the session tokens (`token_store_web.dart`), so a reload mid-exam
+/// still knows the way back to Yantra.
+const String _kReturn = 'yantra.return';
+
+String? readYantraReturn() {
+  try {
+    return web.window.localStorage.getItem(_kReturn);
+  } catch (_) {
+    // Storage blocked (a private window, a sandboxed frame): no way back is
+    // shown, which is the honest answer.
+    return null;
+  }
+}
+
+void writeYantraReturn(String? url) {
+  try {
+    final web.Storage s = web.window.localStorage;
+    if (url == null || url.isEmpty) {
+      s.removeItem(_kReturn);
+    } else {
+      s.setItem(_kReturn, url);
+    }
+  } catch (_) {
+    // As above: without storage there is simply no "Back to Yantra".
+  }
+}
diff --git a/ethara-assessment-fe/lib/yantra_launch.dart b/ethara-assessment-fe/lib/yantra_launch.dart
new file mode 100644
index 0000000..bc9d507
--- /dev/null
+++ b/ethara-assessment-fe/lib/yantra_launch.dart
@@ -0,0 +1,82 @@
+/// Opening this app from Yantra.
+///
+/// Yantra (the worker and ops app) signs people in with Keycloak; this app
+/// does not. Yantra's server asks the assessment bridge for a one-time launch
+/// ticket and sends the browser to `<app>/yantra/launch#ticket=<ticket>`. The
+/// ticket rides in the FRAGMENT, which a browser never sends, so it is never in
+/// an access log; the app trades it once for a session
+/// (`/api/v1/yantra/launch/redeem`), wipes it from the address bar, and opens
+/// the sitting. "Back to Yantra" then returns to the page the person came from.
+///
+/// Pure functions on their inputs so they run on the VM in tests.
+library;
+
+import 'services/yantra_return_stub.dart'
+    if (dart.library.js_interop) 'services/yantra_return_web.dart';
+
+/// Yantra's own address, given at build time. Empty in Ethara's builds, where
+/// none of the Yantra controls appear.
+const String kYantraAppUrl = String.fromEnvironment('YANTRA_APP_URL');
+
+/// The launch ticket in [uri], or null when this is not a launch link.
+String? launchTicketFrom(Uri uri) {
+  final List<String> path = uri.pathSegments
+      .where((String s) => s.isNotEmpty)
+      .toList();
+  if (path.length != 2 || path[0] != 'yantra' || path[1] != 'launch') {
+    return null;
+  }
+  try {
+    final String t = (Uri.splitQueryString(uri.fragment)['ticket'] ?? '')
+        .trim();
+    return t.isEmpty ? null : t;
+  } on ArgumentError {
+    // A malformed escape in the fragment: not a ticket this app can read.
+    return null;
+  }
+}
+
+/// [raw] when it is a web address worth sending a person to, else null.
+///
+/// http(s) only, so a stored value can never become `javascript:`. When the
+/// build knows Yantra's address, only that origin is accepted (the server
+/// already checks this; the client does not take it on trust).
+String? safeReturnUrl(String? raw, {String yantraAppUrl = kYantraAppUrl}) {
+  final Uri? u = Uri.tryParse((raw ?? '').trim());
+  if (u == null || !_isWeb(u)) return null;
+  final Uri? yantra = Uri.tryParse(yantraAppUrl.trim());
+  if (yantra != null && _isWeb(yantra) && yantra.origin != u.origin) {
+    return null;
+  }
+  return u.toString();
+}
+
+/// Remember (or, with null, forget) where "Back to Yantra" goes.
+void rememberYantraReturn(String? url) =>
+    writeYantraReturn(safeReturnUrl(url, yantraAppUrl: ''));
+
+/// Where "Back to Yantra" goes, or null when this session did not come from
+/// Yantra.
+String? yantraReturnUrl({String yantraAppUrl = kYantraAppUrl}) =>
+    safeReturnUrl(readYantraReturn(), yantraAppUrl: yantraAppUrl);
+
+/// The address to open once a ticket is redeemed: the sitting for a candidate,
+/// the page asked for by staff, else home. Never another origin.
+String afterLaunchPath({String? examToken, String? next}) {
+  if (examToken != null && examToken.isNotEmpty) {
+    return '/exam/${Uri.encodeComponent(examToken)}';
+  }
+  final String n = next ?? '';
+  return n.startsWith('/') && !n.startsWith('//') && !n.contains('://')
+      ? n
+      : '/';
+}
+
+/// Yantra's sign-in, for the login form, or null when this build has none.
+Uri? continueWithYantraUri({String yantraAppUrl = kYantraAppUrl}) {
+  final Uri? u = Uri.tryParse(yantraAppUrl.trim());
+  return u != null && _isWeb(u) ? u : null;
+}
+
+bool _isWeb(Uri u) =>
+    (u.scheme == 'http' || u.scheme == 'https') && u.host.isNotEmpty;
diff --git a/ethara-assessment-fe/test/yantra/yantra_launch_test.dart b/ethara-assessment-fe/test/yantra/yantra_launch_test.dart
new file mode 100644
index 0000000..618a6d7
--- /dev/null
+++ b/ethara-assessment-fe/test/yantra/yantra_launch_test.dart
@@ -0,0 +1,89 @@
+// A Yantra launch link carries a one-time ticket in the FRAGMENT (never sent to
+// a server, so never in an access log). The app reads it once, trades it for a
+// session, and remembers where "Back to Yantra" goes.
+import 'package:flutter_test/flutter_test.dart';
+
+import 'package:ethara_assessment/yantra_launch.dart';
+
+void main() {
+  group('launchTicketFrom', () {
+    test('reads the ticket on the launch path only', () {
+      expect(
+        launchTicketFrom(
+          Uri.parse('http://localhost:8096/yantra/launch#ticket=abc%2B1'),
+        ),
+        'abc+1',
+      );
+      expect(
+        launchTicketFrom(Uri.parse('http://h/yantra/launch/#ticket=t')),
+        't',
+      );
+      for (final String url in <String>[
+        'http://h/exam/abc#ticket=t',
+        'http://h/yantra/launch?ticket=t',
+        'http://h/yantra/launch#ticket=',
+        'http://h/yantra/launch#ticket=%20',
+        'http://h/yantra/launch',
+        'http://h/yantra/launch#%zz',
+      ]) {
+        expect(launchTicketFrom(Uri.parse(url)), isNull, reason: url);
+      }
+    });
+  });
+
+  group('safeReturnUrl', () {
+    test('takes http(s) only, and only Yantra when Yantra is known', () {
+      expect(safeReturnUrl('http://localhost:8095/work', yantraAppUrl: ''),
+          'http://localhost:8095/work');
+      expect(safeReturnUrl('javascript:alert(1)', yantraAppUrl: ''), isNull);
+      expect(safeReturnUrl('//evil.example/x', yantraAppUrl: ''), isNull);
+      expect(safeReturnUrl('', yantraAppUrl: ''), isNull);
+      expect(safeReturnUrl(null, yantraAppUrl: ''), isNull);
+      expect(
+        safeReturnUrl(
+          'http://localhost:8095/work',
+          yantraAppUrl: 'http://localhost:8095',
+        ),
+        'http://localhost:8095/work',
+      );
+      expect(
+        safeReturnUrl(
+          'https://evil.example/x',
+          yantraAppUrl: 'http://localhost:8095',
+        ),
+        isNull,
+      );
+    });
+
+    test('a remembered return URL is read back, and cleared by null', () {
+      rememberYantraReturn('http://localhost:8095/work/applications');
+      expect(yantraReturnUrl(yantraAppUrl: ''),
+          'http://localhost:8095/work/applications');
+      rememberYantraReturn('javascript:alert(1)');
+      expect(yantraReturnUrl(yantraAppUrl: ''), isNull);
+      rememberYantraReturn('http://localhost:8095/x');
+      rememberYantraReturn(null);
+      expect(yantraReturnUrl(yantraAppUrl: ''), isNull);
+    });
+  });
+
+  group('afterLaunchPath', () {
+    test('an exam opens its sitting, staff open the path asked for', () {
+      expect(afterLaunchPath(examToken: 'tok', next: '/admin'), '/exam/tok');
+      expect(afterLaunchPath(next: '/assessments/1'), '/assessments/1');
+      expect(afterLaunchPath(), '/');
+      for (final String bad in <String>['//evil', 'https://e/x', 'x', '']) {
+        expect(afterLaunchPath(next: bad), '/', reason: bad);
+      }
+    });
+  });
+
+  test('Continue with Yantra exists only when Yantra is configured', () {
+    expect(continueWithYantraUri(yantraAppUrl: ''), isNull);
+    expect(
+      continueWithYantraUri(yantraAppUrl: 'http://localhost:8095'),
+      Uri.parse('http://localhost:8095'),
+    );
+    expect(continueWithYantraUri(yantraAppUrl: 'ftp://x'), isNull);
+  });
+}
