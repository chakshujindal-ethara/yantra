// The browser's own Back and Forward, over the same trail the in-app pair uses.
//
// WHY THIS IS TESTABLE AT ALL ON THE VM. The `window.history` calls sit behind
// a conditional import and are no-ops here, but the part worth testing is not
// the interop - it is the mapping from a history entry id back onto the trail,
// and that lives in `AssessmentNav.adoptBrowserEntry` as plain Dart. Calling it
// directly is exactly what the real `popstate` handler does, so these tests
// play the part of the Back button without a browser.
//
// The id is what makes the mapping safe. The trail drops its oldest entry past
// `maxEntries`, so an index would slide under a history entry the browser is
// still holding and Back would land on a page the user never visited.
import 'package:flutter_test/flutter_test.dart';
import 'package:ethara_assessment/assessment/nav.dart';

void main() {
  /// The id the browser would have recorded for the entry now showing.
  ///
  /// Read the way the real listener reads it - off the navigator - rather than
  /// counted by the test, so a change to how ids are minted cannot leave these
  /// tests asserting against a private accounting of their own.
  int idNow(AssessmentNav nav) => nav.currentEntryId;

  group('The browser moves the trail', () {
    test('Back lands on the entry the browser names', () {
      final AssessmentNav nav = AssessmentNav();
      nav.replaceRoot(const Analytics());
      final int atAnalytics = idNow(nav);

      nav.go(const TagsAdmin());
      nav.go(const QuestionBank());
      expect(nav.current, isA<QuestionBank>());

      nav.adoptBrowserEntry(atAnalytics);

      expect(nav.current, isA<Analytics>());
      expect(nav.canGoForward, isTrue, reason: 'two pages are still ahead');
    });

    test('Forward comes back again', () {
      final AssessmentNav nav = AssessmentNav();
      nav.replaceRoot(const Analytics());
      final int atAnalytics = idNow(nav);
      nav.go(const TagsAdmin());
      final int atTags = idNow(nav);

      nav.adoptBrowserEntry(atAnalytics);
      expect(nav.current, isA<Analytics>());

      nav.adoptBrowserEntry(atTags);
      expect(nav.current, isA<TagsAdmin>());
    });

    test('naming the entry already showing changes nothing', () {
      final AssessmentNav nav = AssessmentNav();
      nav.replaceRoot(const Analytics());
      nav.go(const TagsAdmin());

      int notified = 0;
      nav.addListener(() => notified++);
      nav.adoptBrowserEntry(idNow(nav));

      // EVERY in-app press produces one of these: the arrow moves the cursor,
      // then steps the browser, and the resulting popstate arrives here naming
      // the entry we already moved to. Doing nothing is what lets one code path
      // serve both buttons.
      expect(nav.current, isA<TagsAdmin>());
      expect(notified, 0);
    });

    test('an id the trail has forgotten is ignored', () {
      final AssessmentNav nav = AssessmentNav();
      nav.replaceRoot(const Analytics());
      nav.go(const TagsAdmin());

      // A history entry from a previous mount, or from another page on this
      // origin. Moving to a guess would show a page nobody asked for.
      nav.adoptBrowserEntry(-99);
      expect(nav.current, isA<TagsAdmin>());

      nav.adoptBrowserEntry(null);
      expect(nav.current, isA<TagsAdmin>());
    });

    test('a new page after a browser Back abandons the forward branch', () {
      final AssessmentNav nav = AssessmentNav();
      nav.replaceRoot(const Analytics());
      final int atAnalytics = idNow(nav);
      nav.go(const TagsAdmin());
      final int atTags = idNow(nav);

      nav.adoptBrowserEntry(atAnalytics);
      nav.go(const QuestionBank());

      expect(nav.canGoForward, isFalse);
      // The abandoned entry must not be reachable by id either - the browser
      // truncates its forward stack on a push, and the trail has to agree.
      nav.adoptBrowserEntry(atTags);
      expect(nav.current, isA<QuestionBank>());
    });
  });

  group('The exam stays a boundary', () {
    test('entering an exam starts a fresh trail the browser cannot escape', () {
      final AssessmentNav nav = AssessmentNav();
      nav.replaceRoot(const Analytics());
      final int atAnalytics = idNow(nav);
      nav.go(const TagsAdmin());

      nav.go(const Exam('tok'));
      expect(nav.current, isA<Exam>());
      expect(nav.canGoBack, isFalse);

      // The candidate is mid-sitting. A browser Back that walked out of the
      // runner is the escape hatch the boundary exists to close, and the ids
      // behind it are no longer in the trail.
      nav.adoptBrowserEntry(atAnalytics);
      expect(nav.current, isA<Exam>());
    });
  });

  group('Ids survive the trail being trimmed', () {
    test('the oldest entry dropping does not shift the others', () {
      final AssessmentNav nav = AssessmentNav();
      nav.replaceRoot(const Analytics());
      nav.go(const TagsAdmin());
      final int atTags = idNow(nav);

      // Past `maxEntries`, so the front of the trail is dropped. An index-based
      // mapping would now resolve `atTags` to a different page; an id does not.
      for (int i = 0; i < AssessmentNav.maxEntries + 5; i++) {
        nav.go(GeneratorDetail('gen-$i'));
      }

      nav.adoptBrowserEntry(atTags);
      expect(
        nav.current,
        isA<GeneratorDetail>(),
        reason: 'Tags fell off the trail, so its id resolves to nothing and the '
            'page must not move',
      );
    });
  });
}
