// The browser's Back and Forward against the REAL section, in a REAL browser.
//
// `browser_history_live_test.dart` drives `AssessmentNav` on its own and passes,
// so a bug that only shows in the app lives above the navigator: in how the
// section mounts it, seeds it, and re-seeds it. This mounts the actual
// `AssessmentSection` and drives it the way a user does - clicking the rail,
// then pressing the browser's own buttons.
import 'package:flutter/material.dart';
import 'package:flutter_test/flutter_test.dart';
import 'package:ethara_assessment/assessment/assessment_section.dart';
import 'package:ethara_assessment/assessment/domain/nav_entries.dart';
import 'package:ethara_assessment/assessment/nav.dart';
import 'package:ethara_assessment/assessment/state/app_store.dart';
import 'package:ethara_assessment/services/browser_history_web.dart';

/// Let the browser deliver `popstate` and the frame settle.
///
/// `history.go` resolves on a later task and fires no Dart future, so the pump
/// has to be given real wall-clock time rather than `pumpAndSettle`, which only
/// drains Flutter's own queues.
Future<void> settleHistory(WidgetTester tester) async {
  for (int i = 0; i < 20; i++) {
    await tester.runAsync(
      () => Future<void>.delayed(const Duration(milliseconds: 15)),
    );
    await tester.pump();
  }
}

void main() {
  Future<AssessmentNav> pumpSection(WidgetTester tester) async {
    tester.view.physicalSize = const Size(1600, 1200);
    tester.view.devicePixelRatio = 1.0;
    addTearDown(tester.view.reset);

    final AppStore store = AppStore();
    addTearDown(store.dispose);

    await tester.pumpWidget(
      MaterialApp(
        home: Scaffold(
          body: AssessmentSection(
            store: store,
            entry: AssessmentEntry.console,
            sidebarBuilder:
                (
                  BuildContext _,
                  List<NavEntry> entries,
                  String _,
                  void Function(String) onOpen,
                ) => Column(
                  mainAxisSize: MainAxisSize.min,
                  children: entries
                      .map(
                        (NavEntry n) => TextButton(
                          key: ValueKey<String>('rail-${n.key}'),
                          onPressed: () => onOpen(n.key),
                          child: Text(n.label),
                        ),
                      )
                      .toList(),
                ),
          ),
        ),
      ),
    );
    await tester.pump();
    return tester
        .widget<AssessmentNavScope>(find.byType(AssessmentNavScope))
        .notifier!;
  }

  Future<void> tapRail(WidgetTester tester, String key) async {
    await tester.tap(find.byKey(ValueKey<String>('rail-$key')));
    await tester.pumpAndSettle();
  }

  testWidgets('browser Forward returns to the page the in-app Back left', (
    WidgetTester tester,
  ) async {
    final AssessmentNav nav = await pumpSection(tester);

    await tapRail(tester, 'tags');
    await tapRail(tester, 'bank');
    expect(nav.current, isA<QuestionBank>());

    nav.back();
    await settleHistory(tester);
    expect(nav.current, isA<TagsAdmin>(), reason: 'the in-app arrow works');

    stepBrowserHistory(1);
    await settleHistory(tester);

    expect(
      nav.current,
      isA<QuestionBank>(),
      reason: 'the browser Forward button must do exactly what the arrow does',
    );
  });

  testWidgets('browser Back and browser Forward round-trip through the rail', (
    WidgetTester tester,
  ) async {
    final AssessmentNav nav = await pumpSection(tester);

    await tapRail(tester, 'tags');
    await tapRail(tester, 'bank');

    stepBrowserHistory(-1);
    await settleHistory(tester);
    expect(nav.current, isA<TagsAdmin>(), reason: 'browser Back');

    stepBrowserHistory(1);
    await settleHistory(tester);
    expect(nav.current, isA<QuestionBank>(), reason: 'browser Forward');
  });
}
