@TestOn('browser')
library;

// The browser's Back and Forward against the REAL `window.history`.
//
// `browser_history_test.dart` drives `adoptBrowserEntry` directly, which proves
// the mapping from an entry id onto the trail. It cannot prove the half that
// only exists in a browser: that our pushes and steps leave the history stack
// the shape we think they do, and that a real `popstate` carries the id back.
// A reported bug - the browser's Forward doing nothing while the in-app arrow
// worked - lived entirely in that half.
//
// Run by `flutter test --platform chrome`, which the Makefile's `test` target
// already does on every run.

import 'package:flutter_test/flutter_test.dart';
import 'package:ethara_assessment/assessment/nav.dart';
import 'package:ethara_assessment/services/browser_history_web.dart';

/// Waits for the navigator to settle after a history step.
///
/// `history.go` is asynchronous: the browser fires `popstate` on a later task,
/// so an assertion made on the next line reads the state before the move. There
/// is no callback to await, so this polls the navigator until it changes or the
/// budget runs out - and a timeout is itself a result, since "nothing happened"
/// is exactly the reported bug.
Future<void> settle(AssessmentNav nav, {AssessmentRoute? until}) async {
  for (int i = 0; i < 50; i++) {
    await Future<void>.delayed(const Duration(milliseconds: 10));
    if (until == null || nav.current == until) return;
  }
}

void main() {
  late AssessmentNav nav;
  late void Function() detach;

  setUp(() {
    nav = AssessmentNav();
    detach = listenBrowserHistory(nav.adoptBrowserEntry);
  });

  tearDown(() {
    detach();
    nav.dispose();
  });

  test('the browser Forward button returns to the page Back left', () async {
    nav.replaceRoot(const Analytics());
    nav.go(const TagsAdmin());
    nav.go(const QuestionBank());
    expect(nav.current, isA<QuestionBank>());

    // The in-app arrow. This one was reported working.
    nav.back();
    await settle(nav, until: const TagsAdmin());
    expect(nav.current, isA<TagsAdmin>());

    // The browser's own Forward button, which is exactly this call.
    stepBrowserHistory(1);
    await settle(nav, until: const QuestionBank());

    expect(
      nav.current,
      isA<QuestionBank>(),
      reason: 'browser Forward must land where the in-app Forward would',
    );
  });

  test('the browser Back button and the in-app arrow agree', () async {
    nav.replaceRoot(const Analytics());
    nav.go(const TagsAdmin());

    stepBrowserHistory(-1);
    await settle(nav, until: const Analytics());
    expect(nav.current, isA<Analytics>());

    stepBrowserHistory(1);
    await settle(nav, until: const TagsAdmin());
    expect(nav.current, isA<TagsAdmin>());
  });

  test('a reload does not let stale entries claim the new trail', () async {
    nav.replaceRoot(const Analytics());
    nav.go(const TagsAdmin());
    nav.go(const QuestionBank());
    final int staleId = nav.currentEntryId;

    // A reload: the browser keeps the entries it already had, and the app comes
    // back up with a brand new navigator over them. Ids used to restart at zero
    // on every mount, so this second trail minted the same ids the entries
    // above were already tagged with - and the browser's buttons then matched a
    // stale entry against whatever page had inherited its number.
    detach();
    nav.dispose();
    nav = AssessmentNav();
    detach = listenBrowserHistory(nav.adoptBrowserEntry);
    nav.replaceRoot(const Analytics());
    nav.go(const TagsAdmin());

    expect(
      nav.currentEntryId,
      isNot(staleId),
      reason: 'a fresh run must not reuse the previous run ids',
    );

    nav.adoptBrowserEntry(staleId);
    expect(
      nav.current,
      isA<TagsAdmin>(),
      reason: 'an entry from the previous page load names nothing here',
    );
  });

  test('in-app Back then browser Forward, repeated, stays in step', () async {
    nav.replaceRoot(const Analytics());
    nav.go(const TagsAdmin());
    nav.go(const QuestionBank());

    for (int round = 0; round < 3; round++) {
      nav.back();
      await settle(nav, until: const TagsAdmin());
      expect(nav.current, isA<TagsAdmin>(), reason: 'round $round, after Back');

      stepBrowserHistory(1);
      await settle(nav, until: const QuestionBank());
      expect(
        nav.current,
        isA<QuestionBank>(),
        reason: 'round $round, after browser Forward',
      );
    }
  });
}
