/// Keeping the browser's Back and Forward in step with the section's trail.
///
/// THE ADDRESS BAR IS NOT TOUCHED. Every entry pushed here reuses the current
/// URL and carries its identity in the history STATE instead. That is what lets
/// browser navigation work without first inventing a URL for all twenty-four
/// routes, which is a much larger change (see the note at the top of
/// `assessment/nav.dart`). The visible consequence is the honest one: Back and
/// Forward work, and a page still cannot be linked to or bookmarked.
///
/// AN ID, NOT AN INDEX. The trail drops its oldest entry past
/// `AssessmentNav.maxEntries`, which would shift every index under a history
/// entry the browser is still holding. A serial id never moves, so an entry the
/// trail has forgotten is simply not found and ignored, rather than resolving
/// to whatever page slid into its slot.
///
/// THE STATE IS A BARE NUMBER rather than an object with a named field. It is
/// read back through an `isA<JSNumber>` check, so a state written by anything
/// else on this origin is recognised as foreign and ignored - which is all a
/// wrapper object would have bought, at the cost of `dart:js_interop_unsafe`
/// and hand-rolled property access.
library;

import 'dart:js_interop';

import 'package:web/web.dart' as web;

int? _idOf(JSAny? state) {
  if (state == null || !state.isA<JSNumber>()) return null;
  return (state as JSNumber).toDartInt;
}

/// False once a history write has failed, and it stays false.
///
/// WHAT IT GUARDS. `AssessmentNav` hands Back and Forward to the browser and
/// waits for `popstate` to move the cursor, which is what keeps the in-app
/// arrows and the browser's buttons from ever disagreeing. If our pushes are
/// being refused there are no entries to step through, so that same delegation
/// would leave both arrows dead. Reporting the loss lets the navigator fall
/// back to moving its own cursor, which is exactly what it does off the web.
///
/// A sandboxed iframe refuses history writes outright, and a page that pushes
/// too many entries too fast is throttled. One failure is enough to know the
/// browser stack no longer mirrors the trail.
bool _writable = true;

bool get hasBrowserHistory => _writable;

void pushBrowserEntry(int entryId) {
  if (!_writable) return;
  try {
    // '' as the URL means "keep the current one". Passing `null` is also legal
    // but some embedders normalise it to the document base, which would drop a
    // `?token=` the app has not finished reading yet.
    web.window.history.pushState(entryId.toJS, '', '');
  } catch (_) {
    _writable = false;
  }
}

void replaceBrowserEntry(int entryId) {
  if (!_writable) return;
  try {
    web.window.history.replaceState(entryId.toJS, '', '');
  } catch (_) {
    _writable = false;
  }
}

void stepBrowserHistory(int delta) {
  try {
    web.window.history.go(delta);
  } catch (_) {
    // See above.
  }
}

void Function() listenBrowserHistory(void Function(int? entryId) onPop) {
  void handler(web.Event event) {
    onPop(_idOf((event as web.PopStateEvent).state));
  }

  final JSFunction listener = handler.toJS;
  try {
    web.window.addEventListener('popstate', listener);
  } catch (_) {
    return () {};
  }
  return () {
    try {
      web.window.removeEventListener('popstate', listener);
    } catch (_) {
      // Tearing down during page unload; nothing left to detach from.
    }
  };
}
