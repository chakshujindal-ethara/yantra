//
// NOT A MIRROR OF ANYTHING. An earlier attempt kept an app-side trail and the
// browser's stack in step by writing to both, and it could not be made to work:
// the browser's stack can be pushed, replaced and stepped, but never cleared,
// never truncated and never inspected. This class does not keep a second copy
// to reconcile - the browser IS the storage, and everything below reads out of
// it.
//
// THE ENTRY CARRIES THE ROUTE, not an index or an id into some list this object
// holds. That is what makes a reload a non-event: the stack survives it, the app
// does not, and an entry that names only a slot in a vanished list is an entry
// the new page cannot render. See `route_codec.dart`.
import 'dart:js_interop';

import 'package:web/web.dart' as web;

import 'nav.dart';
import 'navigation_history.dart';
import 'route_codec.dart';

/// Picked by the conditional import in `assessment_section.dart`.
NavigationHistory createNavigationHistory() => BrowserNavigationHistory();

/// The key our state travels under, so a state object written by anything else
/// on this origin is recognisably not ours.
const String _kMark = 'etharaNav';

class BrowserNavigationHistory implements NavigationHistory {
  BrowserNavigationHistory() {
    _listener = _onPopState.toJS;
    try {
      web.window.addEventListener('popstate', _listener);
    } catch (_) {
      // Nothing to listen to. The arrows still work off `_index`/`_current`,
      // which `push` and `replace` maintain; only the browser's own buttons go
      // quiet, and `_writable` below will already be reporting the trouble.
    }
    _adoptExistingEntry();
  }

  late final JSFunction _listener;

  /// Where we are, and what is here. Written by [push], [replace] and
  /// [_onPopState] - and [_onPopState] is the browser telling us, not us
  /// guessing. There is no other writer.
  int _index = 0;
  int _maxIndex = 0;
  AssessmentRoute _current = const AssessmentsList();

  /// False once a history write has been refused, and it stays false.
  ///
  /// A sandboxed iframe refuses them outright and a page that pushes too fast is
  /// throttled. Either way the stack stops matching what we think, so [back] and
  /// [forward] stop delegating and move locally instead - a degraded mode that
  /// keeps the in-app arrows alive when the browser's buttons cannot be.
  bool _writable = true;

  @override
  void Function()? onChange;

  @override
  int get index => _index;

  @override
  int get maxIndex => _maxIndex;

  @override
  AssessmentRoute get current => _current;

  @override
  bool get wasRestored => _restored;

  bool _restored = false;

  @override
  bool get canGoBack => _index > 0;

  @override
  bool get canGoForward => _index < _maxIndex;

  /// A RELOAD LANDS HERE. The browser restores its stack and hands back the
  /// state it stored, so if this entry is ours the page comes back exactly where
  /// it was rather than at whatever the app opens on.
  ///
  /// `_maxIndex` is deliberately NOT restored. The browser will not say whether
  /// entries exist ahead of us, and lighting Forward on a guess gives the user a
  /// button that does nothing. It comes back the moment they go back.
  void _adoptExistingEntry() {
    final (int, AssessmentRoute)? entry = _readState(web.window.history.state);
    if (entry == null) return;
    _index = entry.$1;
    _maxIndex = entry.$1;
    _current = entry.$2;
    _restored = true;
  }

  (int, AssessmentRoute)? _readState(JSAny? state) {
    if (state == null || !state.isA<JSObject>()) return null;
    final Object? dart = state.dartify();
    if (dart is! Map) return null;
    if (dart[_kMark] != true) return null;
    final Object? i = dart['i'];
    final AssessmentRoute? route = decodeRoute(dart['r']);
    if (i is! int || route == null) return null;
    return (i, route);
  }

  JSAny? _writeState(int i, AssessmentRoute route) => <String, Object?>{
    _kMark: true,
    'i': i,
    'r': encodeRoute(route),
  }.jsify();

  void _onPopState(web.Event event) {
    final (int, AssessmentRoute)? entry = _readState(
      (event as web.PopStateEvent).state,
    );
    // AN ENTRY WE CANNOT NAME LEAVES THE PAGE ALONE. It belongs to an older
    // build, or to something else on this origin. Rendering a guess would show
    // somebody a page they did not ask for.
    if (entry == null) return;
    _index = entry.$1;
    _current = entry.$2;
    if (_index > _maxIndex) _maxIndex = _index;
    onChange?.call();
  }

  @override
  void push(AssessmentRoute route) {
    _index += 1;
    // A push is exactly when the browser discards what was ahead, so the
    // furthest reachable entry becomes this one.
    _maxIndex = _index;
    _current = route;
    if (_writable) {
      try {
        // '' keeps the current URL. Nothing here touches the address bar: the
        // app has no URL per screen, and inventing one is a separate change.
        web.window.history.pushState(_writeState(_index, route), '', '');
      } catch (_) {
        _writable = false;
      }
    }
    onChange?.call();
  }

  @override
  void replace(AssessmentRoute route) {
    _current = route;
    if (_writable) {
      try {
        web.window.history.replaceState(_writeState(_index, route), '', '');
      } catch (_) {
        _writable = false;
      }
    }
    onChange?.call();
  }

  @override
  void back() {
    if (!canGoBack) return;
    if (!_writable) {
      _index -= 1;
      onChange?.call();
      return;
    }
    // THE ARROW AND THE BROWSER'S OWN BUTTON ARE THE SAME CALL. Nothing moves
    // here; `_onPopState` moves it, for both of them.
    web.window.history.go(-1);
  }

  @override
  void forward() {
    if (!canGoForward) return;
    if (!_writable) {
      _index += 1;
      onChange?.call();
      return;
    }
    web.window.history.go(1);
  }

  @override
  void dispose() {
    onChange = null;
    try {
      web.window.removeEventListener('popstate', _listener);
    } catch (_) {
      // Unloading; nothing left to detach from.
    }
  }
}
