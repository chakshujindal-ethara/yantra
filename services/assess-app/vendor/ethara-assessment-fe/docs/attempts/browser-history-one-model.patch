@TestOn('browser')
library;

// The browser IS the history, so this is where that claim is checked.
//
// Everything else in the suite runs on the Dart VM against
// `MemoryNavigationHistory`, which is the real implementation off the web but
// cannot prove the half that only exists in a browser: that a push leaves the
// stack the shape we think, that a real `popstate` carries the route back, and
// that a RELOAD returns the page the user was on. The last one is what the
// previous attempt got wrong and what no VM test could have caught.
//
// Run by `flutter test --platform chrome`, which the Makefile's `test` target
// already does.
import 'package:flutter_test/flutter_test.dart';
import 'package:ethara_assessment/assessment/nav.dart';
import 'package:ethara_assessment/assessment/navigation_history.dart';
import 'package:ethara_assessment/assessment/navigation_history_web.dart';

/// Wait for the browser to deliver `popstate`.
///
/// `history.go` resolves on a later task and hands back no future, so an
/// assertion on the next line reads the state before the move. Running out of
/// budget is itself a result: "nothing happened" is exactly the reported bug.
Future<void> settle(AssessmentNav nav, AssessmentRoute until) async {
  for (int i = 0; i < 60; i++) {
    if (nav.current == until) return;
    await Future<void>.delayed(const Duration(milliseconds: 10));
  }
}

void main() {
  late AssessmentNav nav;

  setUp(() {
    nav = AssessmentNav(history: BrowserNavigationHistory());
  });

  tearDown(() => nav.dispose());

  test('the arrow and the browser button are the same call', () async {
    nav.replaceRoot(const Analytics());
    nav.go(const TagsAdmin());
    nav.go(const QuestionBank());

    // The in-app arrow. It does not move the cursor itself - it asks the
    // browser, and `popstate` moves it. So this IS the browser's Back button,
    // exercised through the arrow.
    nav.back();
    await settle(nav, const TagsAdmin());
    expect(nav.current, const TagsAdmin());

    nav.forward();
    await settle(nav, const QuestionBank());
    expect(nav.current, const QuestionBank());
  });

  test('Forward keeps working over repeated rounds', () async {
    nav.replaceRoot(const Analytics());
    nav.go(const TagsAdmin());
    nav.go(const QuestionBank());

    for (int round = 0; round < 3; round++) {
      nav.back();
      await settle(nav, const TagsAdmin());
      expect(nav.current, const TagsAdmin(), reason: 'round $round back');

      nav.forward();
      await settle(nav, const QuestionBank());
      expect(nav.current, const QuestionBank(), reason: 'round $round forward');
    }
  });

  test('a new page after Back abandons the forward branch', () async {
    nav.replaceRoot(const Analytics());
    nav.go(const TagsAdmin());
    nav.back();
    await settle(nav, const Analytics());

    nav.go(const QuestionBank());
    expect(nav.current, const QuestionBank());
    expect(
      nav.canGoForward,
      isFalse,
      reason: 'the browser discards what was ahead on a push, and so must we',
    );
  });

  test('a reload comes back on the page the user was on', () async {
    nav.replaceRoot(const Analytics());
    nav.go(const GeneratorDetail('g7', tab: 'drafts'));

    // A reload: the browser keeps its stack and hands the entry back, the app
    // does not survive. A fresh history over the same window is exactly what the
    // page gets on the way back up.
    final BrowserNavigationHistory reborn = BrowserNavigationHistory();
    addTearDown(reborn.dispose);

    expect(
      reborn.wasRestored,
      isTrue,
      reason: 'the entry is ours, so the section must not open over the top',
    );
    expect(
      reborn.current,
      const GeneratorDetail('g7', tab: 'drafts'),
      reason: 'including the tab - a dropped field is a different entry',
    );
  });

  test('a pinned sitting is held against the browser too', () async {
    nav.replaceRoot(const MyAssessments());
    nav.go(const Exam('tok'));
    nav.pin((AssessmentRoute r) => r is Exam && r.token == 'tok');

    nav.back();
    // Give the browser every chance to take the candidate out; the trap has to
    // put them back.
    await Future<void>.delayed(const Duration(milliseconds: 250));

    expect(
      nav.current,
      const Exam('tok'),
      reason: 'a live sitting refuses the browser Back button as well as ours',
    );
  });
}
