/// Which history a non-web build gets.
///
/// The app is web-only today, so this exists to satisfy the conditional import
/// in `assessment_section.dart` - and it is what the whole widget suite runs
/// against, since tests execute on the Dart VM.
///
/// [MemoryNavigationHistory] is not a test double. It is the real
/// implementation off the browser, behind the same interface, so the navigator
/// has no branch on which one it holds and the code path a test exercises is
/// the code path that ships.
library;

import 'navigation_history.dart';

NavigationHistory createNavigationHistory() => MemoryNavigationHistory();
=== lib/assessment/route_codec.dart ===
// An `AssessmentRoute` as something the browser can hold.
//
// WHY THIS EXISTS. A history entry has to survive a RELOAD. The browser keeps
// its stack across one, so if an entry carries nothing but an index or an id,
// the app comes back up unable to say what page that entry was - and its Back
// and Forward buttons walk into pages it cannot render. Carrying the route
// itself is what makes a reload a non-event.
//
// A TAG AND ITS FIELDS, not `toString`. The tag is written out here rather than
// taken from `runtimeType`, because a minified web build does not keep class
// names and every route would decode as the same thing in release and not in
// debug - a difference that would never show up in a test.
import 'nav.dart';

/// Every route that can be a history entry, by its wire tag.
///
/// EXHAUSTIVE BY CONSTRUCTION: [encodeRoute] switches over the sealed
/// `AssessmentRoute` hierarchy, so a route added later fails to compile here
/// until it is given a tag. That is the point - a missing case would otherwise
/// surface as a page that silently will not come back after a reload.
Map<String, Object?> encodeRoute(AssessmentRoute r) => switch (r) {
  AssessmentsList() => <String, Object?>{'t': 'assessments'},
  NewAssessment() => <String, Object?>{'t': 'new-assessment'},
  QuestionBank() => <String, Object?>{'t': 'bank'},
  GeneratorList() => <String, Object?>{'t': 'generators'},
  ResponsesList() => <String, Object?>{'t': 'responses'},
  TagsAdmin() => <String, Object?>{'t': 'tags'},
  FormStudio() => <String, Object?>{'t': 'forms'},
  BudgetAdmin() => <String, Object?>{'t': 'budget'},
  LedgerAdmin() => <String, Object?>{'t': 'ledger'},
  SettingsAdmin() => <String, Object?>{'t': 'settings'},
  AccountSettings() => <String, Object?>{'t': 'account'},
  StartHere() => <String, Object?>{'t': 'start'},
  Analytics() => <String, Object?>{'t': 'analytics'},
  MyAssessments() => <String, Object?>{'t': 'mine'},
  MyPerformance() => <String, Object?>{'t': 'performance'},
  AssessmentDetail(:final String id, :final String? tab) => <String, Object?>{
    't': 'assessment',
    'id': id,
    'tab': tab,
  },
  GeneratorDetail(
    :final String id,
    :final String? tab,
    :final bool focusName,
  ) =>
    <String, Object?>{
      't': 'generator',
      'id': id,
      'tab': tab,
      // Part of the route's identity, so it has to round-trip: arriving with
      // the name ready to type into is a different page from arriving to read
      // it, and `==` says so.
      'focus': focusName,
    },
  ReviewQueue(:final String? generatorId) => <String, Object?>{
    't': 'review',
    'gen': generatorId,
  },
  ResponseDetail(:final String attemptId, :final String questionId) =>
    <String, Object?>{'t': 'response', 'a': attemptId, 'q': questionId},
  AttemptDetail(:final String id) => <String, Object?>{'t': 'attempt', 'id': id},
  CandidateDetail(:final String personId) => <String, Object?>{
    't': 'candidate',
    'p': personId,
  },
  CandidatePerformance(:final String personId) => <String, Object?>{
    't': 'candidate-performance',
    'p': personId,
  },
  FormDesigner(:final String id, :final String? tab) => <String, Object?>{
    't': 'form',
    'id': id,
    'tab': tab,
  },
  Exam(
    :final String token,
    :final ExamStage stage,
    :final int questionIndex,
  ) =>
    <String, Object?>{
      't': 'exam',
      'tok': token,
      'stage': stage.name,
      'q': questionIndex,
    },
};

/// The route [data] describes, or null when it describes none.
///
/// NULL IS A REAL ANSWER, not a failure to handle. The state may have been
/// written by an older build of the app, or by something else on this origin
/// entirely. A caller that cannot name the entry leaves the page where it is,
/// which is the only safe move - guessing would show somebody a page they did
/// not ask for.
AssessmentRoute? decodeRoute(Object? data) {
  if (data is! Map) return null;
  final Object? tag = data['t'];
  if (tag is! String) return null;

  String? str(String k) => data[k] is String ? data[k] as String : null;

  return switch (tag) {
    'assessments' => const AssessmentsList(),
    'new-assessment' => const NewAssessment(),
    'bank' => const QuestionBank(),
    'generators' => const GeneratorList(),
    'responses' => const ResponsesList(),
    'tags' => const TagsAdmin(),
    'forms' => const FormStudio(),
    'budget' => const BudgetAdmin(),
    'ledger' => const LedgerAdmin(),
    'settings' => const SettingsAdmin(),
    'account' => const AccountSettings(),
    'start' => const StartHere(),
    'analytics' => const Analytics(),
    'mine' => const MyAssessments(),
    'performance' => const MyPerformance(),
    'assessment' => switch (str('id')) {
      final String id => AssessmentDetail(id, tab: str('tab')),
      _ => null,
    },
    'generator' => switch (str('id')) {
      final String id => GeneratorDetail(
        id,
        tab: str('tab'),
        focusName: data['focus'] == true,
      ),
      _ => null,
    },
    'review' => ReviewQueue(generatorId: str('gen')),
    'response' => switch ((str('a'), str('q'))) {
      (final String a, final String q) => ResponseDetail(a, q),
      _ => null,
    },
    'attempt' => switch (str('id')) {
      final String id => AttemptDetail(id),
      _ => null,
    },
    'candidate' => switch (str('p')) {
      final String p => CandidateDetail(p),
      _ => null,
    },
    'candidate-performance' => switch (str('p')) {
      final String p => CandidatePerformance(p),
      _ => null,
    },
    'form' => switch (str('id')) {
      final String id => FormDesigner(id, tab: str('tab')),
      _ => null,
    },
    'exam' => switch (str('tok')) {
      final String tok => Exam(
        tok,
        stage: ExamStage.values.firstWhere(
          (ExamStage s) => s.name == str('stage'),
          orElse: () => ExamStage.gate,
        ),
        questionIndex: data['q'] is int ? data['q'] as int : 0,
      ),
      _ => null,
    },
    _ => null,
  };
}
=== test/assessment/route_codec_test.dart ===
// Every route survives the round trip into a history entry and back.
//
// WHAT BREAKS WITHOUT THIS. The codec is what lets a RELOAD keep working: the
// browser hands back the state it stored, and the app has to rebuild the exact
// page from it. A route that encodes but decodes wrong comes back as a
// different page - or as the same page with a field dropped, which is worse,
// because `AssessmentDetail('7', tab: 'questions')` and
// `AssessmentDetail('7')` are different history entries by `==` and only one of
// them is where the user was.
//
// So the assertion is equality on the route itself, not a spot-check of fields.
import 'package:flutter_test/flutter_test.dart';
import 'package:ethara_assessment/assessment/nav.dart';
import 'package:ethara_assessment/assessment/route_codec.dart';

void main() {
  /// One of every route, including the field-carrying ones at values that would
  /// expose a dropped or defaulted field.
  const List<AssessmentRoute> every = <AssessmentRoute>[
    AssessmentsList(),
    NewAssessment(),
    QuestionBank(),
    GeneratorList(),
    ResponsesList(),
    TagsAdmin(),
    FormStudio(),
    BudgetAdmin(),
    LedgerAdmin(),
    SettingsAdmin(),
    AccountSettings(),
    StartHere(),
    Analytics(),
    MyAssessments(),
    MyPerformance(),
    AssessmentDetail('42'),
    AssessmentDetail('42', tab: 'questions'),
    GeneratorDetail('g1'),
    GeneratorDetail('g1', tab: 'drafts'),
    GeneratorDetail('g1', focusName: true),
    ReviewQueue(),
    ReviewQueue(generatorId: 'g9'),
    ResponseDetail('att-1', 'q-2'),
    AttemptDetail('att-3'),
    CandidateDetail('p-4'),
    CandidatePerformance('p-5'),
    FormDesigner('f1'),
    FormDesigner('f1', tab: 'preview'),
    Exam('tok'),
    Exam('tok', stage: ExamStage.question, questionIndex: 7),
    Exam('tok', stage: ExamStage.review),
    Exam('tok', stage: ExamStage.complete),
  ];

  test('every route round-trips unchanged', () {
    for (final AssessmentRoute r in every) {
      expect(
        decodeRoute(encodeRoute(r)),
        r,
        reason: '$r did not survive the round trip',
      );
    }
  });

  test('the tags are stable strings, not class names', () {
    // A minified release build does not keep class names. If a tag were ever
    // derived from `runtimeType`, entries written by a debug build would fail to
    // decode in release and nothing in the suite would notice.
    expect(encodeRoute(const Analytics())['t'], 'analytics');
    expect(encodeRoute(const Exam('tok'))['t'], 'exam');
    expect(encodeRoute(const AssessmentDetail('1'))['t'], 'assessment');
  });

  test('a focusName generator is not the same entry as a plain one', () {
    // They differ by `==`, so they are different history entries, so the codec
    // has to keep them apart.
    expect(
      decodeRoute(encodeRoute(const GeneratorDetail('g1', focusName: true))),
      isNot(const GeneratorDetail('g1')),
    );
  });

  group('state this app did not write is refused, not guessed', () {
    test('null, a non-map, and a map with no tag', () {
      expect(decodeRoute(null), isNull);
      expect(decodeRoute(7), isNull);
      expect(decodeRoute('analytics'), isNull);
      expect(decodeRoute(<String, Object?>{}), isNull);
    });

    test('a tag from a newer build', () {
      expect(decodeRoute(<String, Object?>{'t': 'something-else'}), isNull);
    });

    test('a known tag missing the field it needs', () {
      // Better to leave the page alone than to render a detail screen for a
      // record id that is not there.
      expect(decodeRoute(<String, Object?>{'t': 'assessment'}), isNull);
      expect(decodeRoute(<String, Object?>{'t': 'exam'}), isNull);
      expect(decodeRoute(<String, Object?>{'t': 'response', 'a': 'x'}), isNull);
    });

    test('an exam with an unknown stage falls back to the gate', () {
      // The token is the part that matters; a stage name from a build that had
      // more of them should still open the sitting rather than nothing.
      expect(
        decodeRoute(<String, Object?>{'t': 'exam', 'tok': 'k', 'stage': 'zzz'}),
        const Exam('k'),
      );
    });
  });
}
