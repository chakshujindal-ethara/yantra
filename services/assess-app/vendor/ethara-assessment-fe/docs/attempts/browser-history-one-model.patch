=== lib/assessment/navigation_history.dart ===
// ONE history, whoever is pressing the button.
//
// THE PROBLEM THIS SOLVES. The section used to own a trail with a cursor, and
// the browser owns a stack of its own, and an earlier attempt kept the two in
// step by writing to both on every navigation. That cannot be made to work, for
// one specific reason: the browser's stack can be pushed, replaced and stepped,
// but never cleared, never truncated and never inspected. There is no way to
// ask it how many entries are ahead. So any app-side stack that clears itself -
// and `AssessmentNav.replaceRoot` did, on every exam entry and exit - orphans
// entries the browser is still holding, and from then on its buttons walk into
// pages the app has forgotten.
//
// So there is no mirroring here. There is one history, behind this interface,
// and both the in-app arrows and the browser's own buttons are callers of it.
// On the web the implementation IS the browser's stack; everywhere else it is a
// list. Neither the navigator nor any screen knows which it has.
import 'nav.dart';

/// The trail, and where in it we are.
///
/// [index] and [current] move together and are written in exactly one place per
/// implementation - a `popstate` on the web, the step methods in memory. That
/// single writer is the whole point: two writers is what the previous attempt
/// had, and what made the arrows and the browser disagree.
abstract class NavigationHistory {
  /// Position in the trail, from zero.
  int get index;

  /// The furthest entry still reachable with [forward].
  ///
  /// Not `length - 1`: after a reload the browser may hold entries ahead of us
  /// that it will not describe, so an implementation is allowed to report the
  /// conservative answer and light the arrow only once it knows.
  int get maxIndex;

  AssessmentRoute get current;

  /// True when this history came back from a page RELOAD holding a real entry.
  ///
  /// The section opens on a destination of its own choosing; it must not do
  /// that over the top of a page the user was already on. Only the browser can
  /// answer yes, and only because its stack outlives the app.
  bool get wasRestored => false;

  bool get canGoBack => index > 0;
  bool get canGoForward => index < maxIndex;

  /// Visit [route]. Appends, and abandons whatever was ahead.
  void push(AssessmentRoute route);

  /// Replace the entry we are standing on, adding no step.
  ///
  /// For the first route of a session only. A push there would make the
  /// browser's Back undo the app's own startup.
  void replace(AssessmentRoute route);

  /// Ask to move. NOT guaranteed to have happened when this returns - on the
  /// web the browser answers on a later task - so callers read [current] from
  /// the change callback rather than the next line.
  void back();
  void forward();

  /// Called whenever [index] or [current] changes, however it changed.
  void Function()? onChange;

  void dispose();
}

/// The trail as a plain list. What runs off the web, and under every test.
///
/// NOT A TEST DOUBLE. It is the real implementation for every non-browser
/// build, which is why the navigator has no branch on which one it holds: the
/// code path a widget test exercises is the code path that ships.
class MemoryNavigationHistory implements NavigationHistory {
  MemoryNavigationHistory([AssessmentRoute initial = const AssessmentsList()])
    : _entries = <AssessmentRoute>[initial];

  /// Long enough that no real session reaches it, short enough that a tab left
  /// open all day does not hold every page it ever showed.
  static const int maxEntries = 50;

  final List<AssessmentRoute> _entries;
  int _index = 0;

  @override
  void Function()? onChange;

  @override
  int get index => _index;

  @override
  int get maxIndex => _entries.length - 1;

  @override
  AssessmentRoute get current => _entries[_index];

  /// Always false: nothing here outlives the page, so there is never an entry
  /// to come back to.
  @override
  bool get wasRestored => false;

  @override
  bool get canGoBack => _index > 0;

  @override
  bool get canGoForward => _index < maxIndex;

  @override
  void push(AssessmentRoute route) {
    if (canGoForward) _entries.removeRange(_index + 1, _entries.length);
    _entries.add(route);
    if (_entries.length > maxEntries) _entries.removeAt(0);
    _index = _entries.length - 1;
    onChange?.call();
  }

  @override
  void replace(AssessmentRoute route) {
    _entries[_index] = route;
    onChange?.call();
  }

  @override
  void back() {
    if (!canGoBack) return;
    _index--;
    onChange?.call();
  }

  @override
  void forward() {
    if (!canGoForward) return;
    _index++;
    onChange?.call();
  }

  /// The entry [back] would land on, or null. For a tooltip, never for control
  /// flow - see `AssessmentNav.previous`.
  AssessmentRoute? get previous => canGoBack ? _entries[_index - 1] : null;

  AssessmentRoute? get next => canGoForward ? _entries[_index + 1] : null;

  @override
  void dispose() => onChange = null;
}
