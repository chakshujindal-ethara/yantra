<mxfile host="app.diagrams.net" agent="yantra final-nov-2 build_diagrams.py" version="24.0.0">
  <diagram id="04-deployment" name="Deployment: Kubernetes topology for one environment">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Deployment: Kubernetes topology for one environment" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="-60" width="900" height="30" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Istio ingress, a Deployment per service, Odoo in four roles, shared platform services. Sized for year one; extraction triggers in the plan." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#717182;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="-34" width="1200" height="24" as="geometry"/></mxCell>
        <mxCell id="lane0" value="NAMESPACE YANTRA: SERVICES (DEPLOYMENT + HPA + CHART EACH)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFB;strokeColor=#D8D8DE;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontSize=11;fontStyle=1;fontColor=#717182;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="150" width="1100" height="200" as="geometry"/></mxCell>
        <mxCell id="lane1" value="NAMESPACE YANTRA-PLATFORM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFB;strokeColor=#D8D8DE;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontSize=11;fontStyle=1;fontColor=#717182;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="380" width="1100" height="120" as="geometry"/></mxCell>
        <mxCell id="lane2" value="MANAGED OUTSIDE THE CLUSTER" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFB;strokeColor=#D8D8DE;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontSize=11;fontStyle=1;fontColor=#717182;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="530" width="1100" height="120" as="geometry"/></mxCell>
        <mxCell id="edge" value="Istio ingress (Envoy): TLS, routes, rate limit policies, presigned URLs masked in logs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F3F5;strokeColor=#717182;fontColor=#030213;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="0" y="60" width="1100" height="60" as="geometry"/></mxCell>
        <mxCell id="svc_gateway" value="gateway<br><span style="font-size:11px;color:#717182">2-4 pods</span>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#1D4ED8;fontColor=#030213;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="190" width="165" height="60" as="geometry"/></mxCell>
        <mxCell id="svc_market" value="market<br><span style="font-size:11px;color:#717182">2-4 pods</span>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#1D4ED8;fontColor=#030213;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="200" y="190" width="165" height="60" as="geometry"/></mxCell>
        <mxCell id="svc_quality" value="quality<br><span style="font-size:11px;color:#717182">2 pods</span>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#1D4ED8;fontColor=#030213;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="380" y="190" width="165" height="60" as="geometry"/></mxCell>
        <mxCell id="svc_payout" value="payout<br><span style="font-size:11px;color:#717182">2 pods + cron job</span>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#1D4ED8;fontColor=#030213;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="560" y="190" width="165" height="60" as="geometry"/></mxCell>
        <mxCell id="svc_notify" value="notify<br><span style="font-size:11px;color:#717182">1-2 pods</span>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#1D4ED8;fontColor=#030213;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="740" y="190" width="165" height="60" as="geometry"/></mxCell>
        <mxCell id="svc_assess" value="assess<br><span style="font-size:11px;color:#717182">in the Odoo image</span>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#1D4ED8;fontColor=#030213;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="920" y="190" width="165" height="60" as="geometry"/></mxCell>
        <mxCell id="odoo_http" value="odoo-web<br><span style="font-size:11px;color:#717182">prefork workers, HPA</span>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#047857;fontColor=#030213;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="270" width="250" height="60" as="geometry"/></mxCell>
        <mxCell id="odoo_ws" value="odoo-gevent<br><span style="font-size:11px;color:#717182">websocket, no CPU HPA</span>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#047857;fontColor=#030213;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="290" y="270" width="250" height="60" as="geometry"/></mxCell>
        <mxCell id="odoo_cron" value="odoo-cron<br><span style="font-size:11px;color:#717182">lease-locked jobs, outbox drain</span>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#047857;fontColor=#030213;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="560" y="270" width="250" height="60" as="geometry"/></mxCell>
        <mxCell id="odoo_up" value="odoo-upgrade<br><span style="font-size:11px;color:#717182">one-shot migration job</span>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#047857;fontColor=#030213;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="830" y="270" width="250" height="60" as="geometry"/></mxCell>
        <mxCell id="nats" value="NATS JetStream<br><span style="font-size:11px;color:#717182">3 nodes, file store</span>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F3F5;strokeColor=#717182;fontColor=#030213;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="410" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="kc" value="Keycloak<br><span style="font-size:11px;color:#717182">one realm</span>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F3F5;strokeColor=#717182;fontColor=#030213;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="240" y="410" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="redis" value="Redis<br><span style="font-size:11px;color:#717182">idempotency, sessions</span>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F3F5;strokeColor=#717182;fontColor=#030213;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="460" y="410" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="obs" value="Prometheus, Grafana, Loki, OpenTelemetry, Sentry<br><span style="font-size:11px;color:#717182">a trace from app to ledger</span>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F3F5;strokeColor=#717182;fontColor=#030213;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="680" y="410" width="400" height="60" as="geometry"/></mxCell>
        <mxCell id="pg" value="PostgreSQL server<br><span style="font-size:11px;color:#717182">one database per service, PgBouncer transaction mode, PITR; operator in Stage 3</span>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F3F5;strokeColor=#717182;fontColor=#030213;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="560" width="420" height="60" as="geometry"/></mxCell>
        <mxCell id="s3" value="S3<br><span style="font-size:11px;color:#717182">per-project prefixes, IAM roles, SSE-KMS</span>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F3F5;strokeColor=#717182;fontColor=#030213;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="460" y="560" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="harbor" value="Harbor<br><span style="font-size:11px;color:#717182">signed images, SBOM; Stage 3 artifacts</span>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F3F5;strokeColor=#717182;fontColor=#030213;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="780" y="560" width="300" height="60" as="geometry"/></mxCell>
