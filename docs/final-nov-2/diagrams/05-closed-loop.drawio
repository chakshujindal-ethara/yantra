<mxfile host="app.diagrams.net" agent="yantra final-nov-2 build_diagrams.py" version="24.0.0">
  <diagram id="05-closed-loop" name="The business in one loop">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="The business in one loop" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="-60" width="900" height="30" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Every arrow is an event; the accept verdict is the only money event. The stage under each box says when it exists." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#717182;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="-34" width="1200" height="24" as="geometry"/></mxCell>
        <mxCell id="find" value="Find<br><span style="font-size:11px;color:#717182">channels measured per verified person</span><br><span style="font-size:10px;color:#717182;font-family:Courier New">talent, Stage 2</span>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9CA3AF;fontColor=#717182;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="200" height="110" as="geometry"/></mxCell>
        <mxCell id="vet" value="Vet<br><span style="font-size:11px;color:#717182">paper from the project SOP certifies a skill</span><br><span style="font-size:10px;color:#717182;font-family:Courier New">assess, Stage 1</span>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#1D4ED8;fontColor=#030213;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="240" y="0" width="200" height="110" as="geometry"/></mxCell>
        <mxCell id="bench" value="Bench<br><span style="font-size:11px;color:#717182">verified people, evidence levels, availability</span><br><span style="font-size:10px;color:#717182;font-family:Courier New">odoo, Stage 1</span>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#047857;fontColor=#030213;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="480" y="0" width="200" height="110" as="geometry"/></mxCell>
        <mxCell id="quote" value="Quote<br><span style="font-size:11px;color:#717182">price card, cost per unit, margin floor</span><br><span style="font-size:10px;color:#717182;font-family:Courier New">market + payout, Stage 1</span>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#1D4ED8;fontColor=#030213;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="720" y="0" width="200" height="110" as="geometry"/></mxCell>
        <mxCell id="work" value="Work<br><span style="font-size:11px;color:#717182">assigned or open claim, rubric version on every unit</span><br><span style="font-size:10px;color:#717182;font-family:Courier New">market, Stage 1</span>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#1D4ED8;fontColor=#030213;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="960" y="0" width="200" height="110" as="geometry"/></mxCell>
        <mxCell id="review" value="Review<br><span style="font-size:11px;color:#717182">reason code, rubric-unclear flag; accept = money</span><br><span style="font-size:10px;color:#717182;font-family:Courier New">quality, Stage 1</span>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#C2410C;fontColor=#030213;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="960" y="180" width="200" height="110" as="geometry"/></mxCell>
        <mxCell id="pay" value="Pay<br><span style="font-size:11px;color:#717182">weekly, TDS, identity bound to the account</span><br><span style="font-size:10px;color:#717182;font-family:Courier New">payout + odoo, Stage 1</span>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#1D4ED8;fontColor=#030213;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="720" y="180" width="200" height="110" as="geometry"/></mxCell>
        <mxCell id="measure" value="Measure<br><span style="font-size:11px;color:#717182">standard signals from events</span><br><span style="font-size:10px;color:#717182;font-family:Courier New">performance, Stage 2</span>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9CA3AF;fontColor=#717182;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="480" y="180" width="200" height="110" as="geometry"/></mxCell>
        <mxCell id="catalogue" value="Catalogue<br><span style="font-size:11px;color:#717182">artifacts with lineage, rights, quality gate</span><br><span style="font-size:10px;color:#717182;font-family:Courier New">hub, Stage 2-3</span>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9CA3AF;fontColor=#717182;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="240" y="180" width="200" height="110" as="geometry"/></mxCell>
