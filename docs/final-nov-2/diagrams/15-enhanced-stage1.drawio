<mxfile host="app.diagrams.net" agent="yantra final-nov-2 build_diagrams.py" version="24.0.0">
  <diagram id="15-enhanced-stage1" name="Enhanced plan: four deployables in Stage 1, ten services in the code">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Enhanced plan: four deployables in Stage 1, ten services in the code" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="-60" width="900" height="30" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Each module keeps its own schema, contract and outbox. The deployment composes them; a split later is a chart change." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#717182;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="-34" width="1200" height="24" as="geometry"/></mxCell>
        <mxCell id="lane0" value="CLIENTS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFB;strokeColor=#D8D8DE;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontSize=11;fontStyle=1;fontColor=#717182;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1180" height="120" as="geometry"/></mxCell>
        <mxCell id="lane1" value="DEPLOYABLE 2: WORK (ONE PROCESS, THREE SCHEMAS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F8FF;strokeColor=#D8D8DE;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontSize=11;fontStyle=1;fontColor=#717182;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="280" width="560" height="240" as="geometry"/></mxCell>
        <mxCell id="lane2" value="DEPLOYABLE 3: MONEY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9F3;strokeColor=#D8D8DE;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontSize=11;fontStyle=1;fontColor=#717182;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="580" y="280" width="400" height="240" as="geometry"/></mxCell>
        <mxCell id="lane3" value="SHARED PLATFORM, ONE REGION IN INDIA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFB;strokeColor=#D8D8DE;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontSize=11;fontStyle=1;fontColor=#717182;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="680" width="1180" height="110" as="geometry"/></mxCell>
        <mxCell id="app" value="Flutter app<br><span style="font-size:11px;color:#717182">workers, reviewers, candidates, ops on mobile</span><br><span style="font-size:10px;color:#717182;font-family:Courier New">app/</span>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBDAF7;strokeColor=#B800B8;fontColor=#030213;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="35" width="300" height="65" as="geometry"/></mxCell>
        <mxCell id="bo" value="Odoo backend UI<br><span style="font-size:11px;color:#717182">ops, finance, HR</span>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#047857;fontColor=#030213;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="860" y="35" width="300" height="65" as="geometry"/></mxCell>
        <mxCell id="gw" value="gateway<br><span style="font-size:11px;color:#717182">deployable 1: JWT, rate limits, idempotency, public OpenAPI</span><br><span style="font-size:10px;color:#717182;font-family:Courier New">services/gateway</span>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#1D4ED8;fontColor=#030213;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="170" width="300" height="70" as="geometry"/></mxCell>
        <mxCell id="market" value="market<br><span style="font-size:11px;color:#717182">projects, batches, units, claims, price cards, delivery gate</span><br><span style="font-size:10px;color:#717182;font-family:Courier New">schema market</span>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#1D4ED8;fontColor=#030213;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="320" width="160" height="80" as="geometry"/></mxCell>
        <mxCell id="quality" value="quality<br><span style="font-size:11px;color:#717182">review claims, verdicts, audit, reason codes</span><br><span style="font-size:10px;color:#717182;font-family:Courier New">schema quality</span>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#1D4ED8;fontColor=#030213;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="200" y="320" width="160" height="80" as="geometry"/></mxCell>
        <mxCell id="notify" value="notify<br><span style="font-size:11px;color:#717182">email, push, WhatsApp</span><br><span style="font-size:10px;color:#717182;font-family:Courier New">schema notify</span>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#1D4ED8;fontColor=#030213;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="380" y="320" width="160" height="80" as="geometry"/></mxCell>
        <mxCell id="rule" value="Module rules
a module imports only packages/*; its own database role; events out through its outbox, even to a sibling; one migration job per module" style="text;html=1;align=left;verticalAlign=middle;fontColor=#717182;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="420" width="520" height="70" as="geometry"/></mxCell>
        <mxCell id="payout" value="payout<br><span style="font-size:11px;color:#717182">earnings, pay windows, holds, cost ledger, rail adapters; its own release train and deploy freeze</span><br><span style="font-size:10px;color:#717182;font-family:Courier New">schema payout</span>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#C2410C;fontColor=#030213;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="600" y="320" width="360" height="80" as="geometry"/></mxCell>
        <mxCell id="later" value="hub, runner, tracker, analytics<br><span style="font-size:11px;color:#717182">directories with a contract and a health endpoint; not deployed in Stage 1</span>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9CA3AF;fontColor=#717182;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="600" y="420" width="360" height="70" as="geometry"/></mxCell>
        <mxCell id="bus" value="NATS JetStream<br><span style="font-size:11px;color:#717182">every module publishes from its outbox; CloudEvents; replay</span>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F3F5;strokeColor=#717182;fontColor=#030213;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1000" y="320" width="160" height="170" as="geometry"/></mxCell>
        <mxCell id="odoo" value="odoo: deployable 4, the system of record<br><span style="font-size:11px;color:#717182">worker record, bench, accounting, vendor bills with TDS, client invoices; the Assessment v2 engine behind the assess contract</span><br><span style="font-size:10px;color:#717182;font-family:Courier New">services/odoo, ethara_* addons</span>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#047857;fontColor=#030213;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="300" y="560" width="580" height="80" as="geometry"/></mxCell>
        <mxCell id="kc" value="Keycloak<br><span style="font-size:11px;color:#717182">OIDC staff, JWT workers and services</span>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F3F5;strokeColor=#717182;fontColor=#030213;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="710" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="pg" value="PostgreSQL<br><span style="font-size:11px;color:#717182">one schema and one role per module, PgBouncer, PITR</span>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F3F5;strokeColor=#717182;fontColor=#030213;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="250" y="710" width="260" height="60" as="geometry"/></mxCell>
        <mxCell id="redis" value="Redis<br><span style="font-size:11px;color:#717182">idempotency, sessions, cache</span>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F3F5;strokeColor=#717182;fontColor=#030213;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="540" y="710" width="180" height="60" as="geometry"/></mxCell>
