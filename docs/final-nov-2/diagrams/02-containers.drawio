        <mxCell id="hub" value="hub<br><span style="font-size:11px;color:#717182">artifacts, lineage, rights, entitlements</span><br><span style="font-size:10px;color:#717182;font-family:Courier New">Stage 2</span>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9CA3AF;fontColor=#717182;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="20" y="420" width="180" height="70" as="geometry"/></mxCell>
        <mxCell id="runner" value="runner<br><span style="font-size:11px;color:#717182">environment quality gate</span><br><span style="font-size:10px;color:#717182;font-family:Courier New">Stage 2 prototype</span>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9CA3AF;fontColor=#717182;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="220" y="420" width="180" height="70" as="geometry"/></mxCell>
        <mxCell id="tracker" value="tracker<br><span style="font-size:11px;color:#717182">hourly evidence</span><br><span style="font-size:10px;color:#717182;font-family:Courier New">scaffold</span>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9CA3AF;fontColor=#717182;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="420" y="420" width="180" height="70" as="geometry"/></mxCell>
        <mxCell id="analytics" value="analytics<br><span style="font-size:11px;color:#717182">CDC read models</span><br><span style="font-size:10px;color:#717182;font-family:Courier New">scaffold</span>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9CA3AF;fontColor=#717182;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="620" y="420" width="180" height="70" as="geometry"/></mxCell>
        <mxCell id="bus" value="NATS JetStream<br><span style="font-size:11px;color:#717182">every service publishes from its outbox and subscribes; CloudEvents</span>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F3F5;strokeColor=#717182;fontColor=#030213;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1000" y="320" width="160" height="170" as="geometry"/></mxCell>
        <mxCell id="odoo" value="odoo: system of record<br><span style="font-size:11px;color:#717182">worker record, bench, skills, accounting, vendor bills with TDS, client invoices</span><br><span style="font-size:10px;color:#717182;font-family:Courier New">services/odoo, ethara_* addons</span>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#047857;fontColor=#030213;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="420" y="560" width="380" height="80" as="geometry"/></mxCell>
