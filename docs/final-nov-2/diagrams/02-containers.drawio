<mxfile host="app.diagrams.net" agent="yantra final-nov-2 build_diagrams.py" version="24.0.0">
  <diagram id="02-containers" name="Containers: one repository, a ring of services around Odoo">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Containers: one repository, a ring of services around Odoo" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="-60" width="900" height="30" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Level 2. Every service is its own deployable with its own database. The app reaches services only through the gateway." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#717182;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="-34" width="1200" height="24" as="geometry"/></mxCell>
        <mxCell id="lane0" value="CLIENTS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFB;strokeColor=#D8D8DE;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontSize=11;fontStyle=1;fontColor=#717182;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1180" height="120" as="geometry"/></mxCell>
        <mxCell id="lane1" value="SERVICE RING: ONE DEPLOYABLE AND ONE POSTGRESQL DATABASE EACH" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFB;strokeColor=#D8D8DE;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontSize=11;fontStyle=1;fontColor=#717182;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="280" width="1180" height="230" as="geometry"/></mxCell>
        <mxCell id="lane2" value="SHARED PLATFORM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFB;strokeColor=#D8D8DE;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontSize=11;fontStyle=1;fontColor=#717182;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="680" width="1180" height="110" as="geometry"/></mxCell>
        <mxCell id="app" value="Flutter app<br><span style="font-size:11px;color:#717182">workers, reviewers, candidates, ops on mobile</span><br><span style="font-size:10px;color:#717182;font-family:Courier New">app/</span>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBDAF7;strokeColor=#B800B8;fontColor=#030213;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="35" width="300" height="65" as="geometry"/></mxCell>
        <mxCell id="bo" value="Odoo backend UI<br><span style="font-size:11px;color:#717182">ops, finance, HR</span>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#047857;fontColor=#030213;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="860" y="35" width="300" height="65" as="geometry"/></mxCell>
        <mxCell id="gw" value="gateway<br><span style="font-size:11px;color:#717182">Keycloak JWT, rate limits, idempotency keys, public OpenAPI</span><br><span style="font-size:10px;color:#717182;font-family:Courier New">services/gateway</span>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#1D4ED8;fontColor=#030213;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="170" width="300" height="70" as="geometry"/></mxCell>
        <mxCell id="assess" value="assess<br><span style="font-size:11px;color:#717182">papers, certification, skills write-back</span><br><span style="font-size:10px;color:#717182;font-family:Courier New">in the Odoo image (Stage 1)</span>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#1D4ED8;fontColor=#030213;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="320" width="180" height="80" as="geometry"/></mxCell>
        <mxCell id="market" value="market<br><span style="font-size:11px;color:#717182">projects, batches, units, claims, price cards, delivery gate</span>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#1D4ED8;fontColor=#030213;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="220" y="320" width="180" height="80" as="geometry"/></mxCell>
        <mxCell id="quality" value="quality<br><span style="font-size:11px;color:#717182">review claims, verdicts, audit, reason codes</span>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#1D4ED8;fontColor=#030213;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="420" y="320" width="180" height="80" as="geometry"/></mxCell>
        <mxCell id="payout" value="payout<br><span style="font-size:11px;color:#717182">earnings, pay windows, cost ledger, rails</span>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#1D4ED8;fontColor=#030213;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="620" y="320" width="180" height="80" as="geometry"/></mxCell>
