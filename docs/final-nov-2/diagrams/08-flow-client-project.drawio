<mxfile host="app.diagrams.net" agent="yantra final-nov-2 build_diagrams.py" version="24.0.0">
  <diagram id="08-flow-client-project" name="User flow: ops and the client, from brief to invoice">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="User flow: ops and the client, from brief to invoice" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="-60" width="900" height="30" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="One project is configuration, not a new app. The export gate and the margin report close the loop with the client." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#717182;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="-34" width="1200" height="24" as="geometry"/></mxCell>
        <mxCell id="s" value="Client brief<br><span style="font-size:11px;color:#FFFFFF">task type, volume, deadline, quality bar</span>" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#030213;strokeColor=#030213;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="190" height="76" as="geometry"/></mxCell>
        <mxCell id="setup" value="Project setup<br><span style="font-size:11px;color:#717182">schema, rubric v1, quality policy, rate card</span>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4B4B57;fontColor=#030213;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="240" y="0" width="190" height="76" as="geometry"/></mxCell>
        <mxCell id="price" value="Price card<br><span style="font-size:11px;color:#717182">unit price frozen next to unit pay; margin floor checked</span>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4B4B57;fontColor=#030213;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="480" y="0" width="190" height="76" as="geometry"/></mxCell>
        <mxCell id="floor" value="Below floor?<br><span style="font-size:11px;color:#717182">warn, record approval</span>" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4B4B57;fontColor=#030213;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="720" y="0" width="190" height="76" as="geometry"/></mxCell>
        <mxCell id="import" value="Batch import<br><span style="font-size:11px;color:#717182">dry run reports every bad line</span>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4B4B57;fontColor=#030213;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="960" y="0" width="190" height="76" as="geometry"/></mxCell>
        <mxCell id="publish" value="Publish<br><span style="font-size:11px;color:#717182">freezes pay and price; assigned or open mode</span>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#B91C1C;fontColor=#030213;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="960" y="146" width="190" height="76" as="geometry"/></mxCell>
        <mxCell id="work" value="Claims and reviews<br><span style="font-size:11px;color:#717182">workers and reviewers, weeks 1-n</span>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4B4B57;fontColor=#030213;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="720" y="146" width="190" height="76" as="geometry"/></mxCell>
        <mxCell id="gate" value="Delivery gate<br><span style="font-size:11px;color:#717182">every line validated; one bad line holds the batch</span>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#B91C1C;fontColor=#030213;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="480" y="146" width="190" height="76" as="geometry"/></mxCell>
        <mxCell id="manifest" value="Manifest<br><span style="font-size:11px;color:#717182">checksums, provenance, rubric version</span>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4B4B57;fontColor=#030213;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="240" y="146" width="190" height="76" as="geometry"/></mxCell>
        <mxCell id="invoice" value="Invoice<br><span style="font-size:11px;color:#717182">accepted units x rate; e-invoice if Indian</span>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#C2410C;fontColor=#030213;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="0" y="146" width="190" height="76" as="geometry"/></mxCell>
        <mxCell id="margin" value="Margin report<br><span style="font-size:11px;color:#717182">invoice minus every cost line</span>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4B4B57;fontColor=#030213;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="0" y="292" width="190" height="76" as="geometry"/></mxCell>
        <mxCell id="bench" value="People return to the bench<br><span style="font-size:11px;color:#FFFFFF">the four numbers update</span>" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#047857;strokeColor=#047857;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="240" y="292" width="190" height="76" as="geometry"/></mxCell>
