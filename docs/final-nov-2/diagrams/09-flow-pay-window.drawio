<mxfile host="app.diagrams.net" agent="yantra final-nov-2 build_diagrams.py" version="24.0.0">
  <diagram id="09-flow-pay-window" name="User flow: finance, the weekly pay window">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="User flow: finance, the weekly pay window" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="-60" width="900" height="30" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Runs every week from the first dogfood batch. Zero deltas is the gate." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#717182;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="-34" width="1200" height="24" as="geometry"/></mxCell>
        <mxCell id="s" value="Friday 23:59 IST<br><span style="font-size:11px;color:#FFFFFF">window closes</span>" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#030213;strokeColor=#030213;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="190" height="76" as="geometry"/></mxCell>
        <mxCell id="holds" value="Apply holds<br><span style="font-size:11px;color:#717182">first payout 7 days; integrity holds before payout, never clawbacks</span>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4B4B57;fontColor=#030213;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="240" y="0" width="190" height="76" as="geometry"/></mxCell>
        <mxCell id="bills" value="Vendor bills<br><span style="font-size:11px;color:#717182">one self-billed bill per worker with TDS</span>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4B4B57;fontColor=#030213;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="480" y="0" width="190" height="76" as="geometry"/></mxCell>
        <mxCell id="approve" value="Two approvals<br><span style="font-size:11px;color:#717182">finance lead plus one; caps per window</span>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#B91C1C;fontColor=#030213;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="720" y="0" width="190" height="76" as="geometry"/></mxCell>
        <mxCell id="rail" value="RazorpayX<br><span style="font-size:11px;color:#717182">bank file as fallback</span>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#C2410C;fontColor=#030213;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="720" y="146" width="190" height="76" as="geometry"/></mxCell>
        <mxCell id="webhook" value="Webhook<br><span style="font-size:11px;color:#717182">signed, replay window</span>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4B4B57;fontColor=#030213;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="480" y="146" width="190" height="76" as="geometry"/></mxCell>
        <mxCell id="recon" value="Reconciliation<br><span style="font-size:11px;color:#717182">earnings = bills = payouts net + TDS, to the paisa; alerts, never auto-adjusts</span>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#B91C1C;fontColor=#030213;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="240" y="146" width="190" height="76" as="geometry"/></mxCell>
        <mxCell id="stmt" value="Statements<br><span style="font-size:11px;color:#FFFFFF">in the app; disputes answered within the next window</span>" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#047857;strokeColor=#047857;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="0" y="146" width="190" height="76" as="geometry"/></mxCell>
        <mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4B4B57;strokeWidth=1.5;fontSize=11;fontColor=#4B4B57;fontFamily=Helvetica;endArrow=block;endFill=1;" edge="1" parent="1" source="s" target="holds"><mxGeometry relative="1" as="geometry">
        </mxGeometry></mxCell>
