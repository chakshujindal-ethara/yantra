<mxfile host="app.diagrams.net" agent="yantra final-nov-2 build_diagrams.py" version="24.0.0">
  <diagram id="06-flow-worker" name="User flow: the worker, from first contact to first payout">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="User flow: the worker, from first contact to first payout" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="-60" width="900" height="30" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="What the person sees, in order. Red boxes are hard gates; the orange box is the only place money is created." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#717182;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="-34" width="1200" height="24" as="geometry"/></mxCell>
        <mxCell id="s" value="Hears about Yantra<br><span style="font-size:11px;color:#FFFFFF">a measured channel, never a DM</span>" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#030213;strokeColor=#030213;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="190" height="76" as="geometry"/></mxCell>
        <mxCell id="apply" value="Applies<br><span style="font-size:11px;color:#717182">60-second form with hard questions</span>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4B4B57;fontColor=#030213;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="240" y="0" width="190" height="76" as="geometry"/></mxCell>
        <mxCell id="paper" value="Takes the paper<br><span style="font-size:11px;color:#717182">generated from the project SOP, proctored</span>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4B4B57;fontColor=#030213;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="480" y="0" width="190" height="76" as="geometry"/></mxCell>
        <mxCell id="cert" value="Certified<br><span style="font-size:11px;color:#717182">skill verified; retake policy applies</span>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#B91C1C;fontColor=#030213;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="720" y="0" width="190" height="76" as="geometry"/></mxCell>
        <mxCell id="onboard" value="Onboarding checklist<br><span style="font-size:11px;color:#717182">agreements, DPDP consent, documents, PAN and bank, payout setup in the app</span>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4B4B57;fontColor=#030213;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="960" y="0" width="190" height="76" as="geometry"/></mxCell>
        <mxCell id="eligible" value="ELIGIBLE<br><span style="font-size:11px;color:#717182">computed, never set by hand; identity bound to the payout account</span>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#B91C1C;fontColor=#030213;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="960" y="146" width="190" height="76" as="geometry"/></mxCell>
        <mxCell id="bench" value="On the bench<br><span style="font-size:11px;color:#717182">skills with evidence level, availability</span>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4B4B57;fontColor=#030213;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="720" y="146" width="190" height="76" as="geometry"/></mxCell>
        <mxCell id="claim" value="Claims a task<br><span style="font-size:11px;color:#717182">pay shown first; one live claim; TTL</span>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4B4B57;fontColor=#030213;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="480" y="146" width="190" height="76" as="geometry"/></mxCell>
        <mxCell id="work" value="Works it<br><span style="font-size:11px;color:#717182">schema-rendered form; rubric version visible; can flag rubric unclear</span>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4B4B57;fontColor=#030213;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="240" y="146" width="190" height="76" as="geometry"/></mxCell>
        <mxCell id="submit" value="Submits<br><span style="font-size:11px;color:#717182">idempotent; a retry never duplicates</span>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4B4B57;fontColor=#030213;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="0" y="146" width="190" height="76" as="geometry"/></mxCell>
        <mxCell id="verdict" value="Verdict<br><span style="font-size:11px;color:#717182">accept, needs edits, reject</span>" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4B4B57;fontColor=#030213;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="0" y="292" width="190" height="76" as="geometry"/></mxCell>
        <mxCell id="earn" value="Earning recorded<br><span style="font-size:11px;color:#717182">on accept only</span>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#C2410C;fontColor=#030213;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="240" y="292" width="190" height="76" as="geometry"/></mxCell>
        <mxCell id="window" value="Weekly window<br><span style="font-size:11px;color:#717182">Saturday to Friday IST; holds; TDS</span>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4B4B57;fontColor=#030213;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="480" y="292" width="190" height="76" as="geometry"/></mxCell>
        <mxCell id="paid" value="Paid Wednesday<br><span style="font-size:11px;color:#FFFFFF">RazorpayX; statement in the app</span>" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#047857;strokeColor=#047857;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="720" y="292" width="190" height="76" as="geometry"/></mxCell>
        <mxCell id="back" value="Back on the bench<br><span style="font-size:11px;color:#717182">project ends, zero idle cost</span>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4B4B57;fontColor=#030213;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="960" y="292" width="190" height="76" as="geometry"/></mxCell>
